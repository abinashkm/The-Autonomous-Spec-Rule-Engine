{
  "name": "@specgate/core",
  "version": "0.0.0",
  "description": "SpecGate core library — all logic (stack detect, spec engine, rule engine, gate runner, trace, drift, fix-loop, report).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/abinashkm/The-Autonomous-Spec-Rule-Engine.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/abinashkm/The-Autonomous-Spec-Rule-Engine",
  "bugs": "https://github.com/abinashkm/The-Autonomous-Spec-Rule-Engine/issues",
  "keywords": [
    "ai",
    "agents",
    "code-review",
    "static-analysis",
    "spec"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "execa": "^10.1.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "mdast-util-to-string": "^4.0.0",
    "picocolors": "^1.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4"
  }
}
