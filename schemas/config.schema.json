{
  "$id": "https://raw.githubusercontent.com/abinashkm/The-Autonomous-Spec-Rule-Engine/main/schemas/config.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "context": {
      "additionalProperties": false,
      "default": {
        "max_rule_tokens": 4000
      },
      "properties": {
        "max_rule_tokens": {
          "maximum": 100000,
          "minimum": 500,
          "type": "integer"
        }
      },
      "required": [
        "max_rule_tokens"
      ],
      "type": "object"
    },
    "fix_loop": {
      "additionalProperties": false,
      "default": {
        "max_attempts": 3
      },
      "properties": {
        "max_attempts": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_attempts"
      ],
      "type": "object"
    },
    "gates": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "strict",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "blocking_at"
          ],
          "type": "object"
        },
        "coverage": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "strict",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "changed_files_min": {
              "default": 70,
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "changed_files_min",
            "blocking_at"
          ],
          "type": "object"
        },
        "dependencies": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "strict",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "tool": {
              "default": "osv-scanner",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "tool",
            "blocking_at"
          ],
          "type": "object"
        },
        "lint": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "standard",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "command": {
              "anyOf": [
                {
                  "const": "auto",
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "default": "auto"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "command",
            "blocking_at"
          ],
          "type": "object"
        },
        "secrets": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "standard",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "tool": {
              "default": "gitleaks",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "tool",
            "blocking_at"
          ],
          "type": "object"
        },
        "spec": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "strict",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            },
            "require_spec_for_changes": {
              "default": true,
              "type": "boolean"
            }
          },
          "required": [
            "enabled",
            "require_spec_for_changes",
            "blocking_at"
          ],
          "type": "object"
        },
        "tests": {
          "additionalProperties": false,
          "properties": {
            "blocking_at": {
              "default": "standard",
              "enum": [
                "advisory",
                "standard",
                "strict"
              ],
              "type": "string"
            },
            "command": {
              "anyOf": [
                {
                  "const": "auto",
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "default": "auto"
            },
            "enabled": {
              "default": true,
              "type": "boolean"
            },
            "reason": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "command",
            "blocking_at"
          ],
          "type": "object"
        }
      },
      "required": [
        "secrets",
        "lint",
        "tests",
        "coverage",
        "architecture",
        "dependencies",
        "spec"
      ],
      "type": "object"
    },
    "packs": {
      "default": [],
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stack": {
      "additionalProperties": false,
      "default": {
        "override": {}
      },
      "properties": {
        "override": {
          "additionalProperties": false,
          "default": {},
          "properties": {
            "ciProvider": {
              "type": "string"
            },
            "frameworks": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "languages": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "linters": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "packageManagers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "testRunners": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "required": [
        "override"
      ],
      "type": "object"
    },
    "strictness": {
      "enum": [
        "advisory",
        "standard",
        "strict"
      ],
      "type": "string"
    },
    "telemetry": {
      "default": "off",
      "enum": [
        "off",
        "on"
      ],
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "version",
    "strictness",
    "stack",
    "packs",
    "gates",
    "fix_loop",
    "context",
    "telemetry"
  ],
  "title": "SpecGateConfig",
  "type": "object"
}
